# Firebase Web Credentials
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_APP_ID=1:your_project_number:web:your_web_app_id

# Firebase Android Credentials (from google-services.json)
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:your_project_number:android:your_android_app_id

FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MEASUREMENT_ID=

GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

